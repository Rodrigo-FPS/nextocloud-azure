#copiar como .env y completar con los valores reales
#las contrasenas se generan con Docker secrets y no van aqui

#IP publica de VM1 usada en trusted_domains overwrite y Caddyfile
MANAGER_IP=<IP_PUBLICA_VM1>

#IP privada de VM1 usada en docker swarm init
MANAGER_PRIVATE_IP=<IP_PRIVADA_VM1>

#IP publica de VM2 usada para SSH durante el despliegue
WORKER_IP=<IP_PUBLICA_VM2>

#usuario SSH en ambas VMs
SSH_USER=azureuser

#nombre del stack de Docker Swarm
STACK_NAME=nextcloud
